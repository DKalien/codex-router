#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

usage() {
  cat <<'EOF'
Usage: model-router codex COMMAND [arguments]

Commands:
  install, provider-key, enable, disable, uninstall, start

  ./bin/model-router codex install
  ./bin/model-router codex provider-key mimo-token-plan set
EOF
}

if [ "$#" -lt 2 ]; then
  usage >&2
  exit 2
fi

target=$1
command=$2
shift 2

case "$target" in
  codex) ;;
  *) echo "Unknown target: $target" >&2; usage >&2; exit 2 ;;
esac

case "$command" in
  install|provider-key|enable|disable|uninstall|start) ;;
  *) echo "Unknown command: $command" >&2; usage >&2; exit 2 ;;
esac

MODEL_ROUTER_TARGET=$target
export MODEL_ROUTER_TARGET
exec "$repo_dir/bin/$command" "$@"

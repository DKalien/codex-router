#!/bin/sh
set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
monitor_dir="$repo_dir/mimo-token-monitor"
launcher="$monitor_dir/launcher.py"
if [ ! -f "$launcher" ]; then
  echo "找不到合并的 MiMo Token Monitor：$launcher" >&2
  exit 1
fi
if [ -x "$monitor_dir/.venv/bin/python" ]; then
  python_cmd="$monitor_dir/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
  python_cmd=$(command -v python3)
elif command -v python >/dev/null 2>&1; then
  python_cmd=$(command -v python)
else
  echo "运行 MiMo Token Monitor 需要 Python 3；请先安装 Python 并安装 mimo-token-monitor/requirements.txt。" >&2
  exit 1
fi
exec "$python_cmd" "$launcher" "$@"

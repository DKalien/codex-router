{
  "version": 1,
  "providers": [
    {
      "id": "supergpt-relay",
      "displayName": "SuperGPT Relay",
      "kind": "openai-compatible",
      "ownedBy": "supergpt",
      "baseUrl": "https://api.supergpt.dev/v1",
      "baseUrlEnv": "SUPERGPT_BASE_URL",
      "credential": {
        "environment": [
          "SUPERGPT_API_KEY"
        ],
        "file": "supergpt-api-key.secret",
        "keychainServices": [
          "codex-router-supergpt"
        ],
        "prompt": "SuperGPT API key"
      },
      "protocol": "openai-responses"
    }
  ]
}
